# ==========================================
# Root .gitignore for AI Data Anomaly Detection Copilot
# ==========================================

# --- Environment & Secret Files (CRITICAL: Do NOT commit) ---
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
*.pem
*.key

# --- Python Virtual Environments ---
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# --- Python Cache & Build Artifacts ---
__pycache__/
*.py[cod]
*$py.class
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Pytest & Coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/

# --- Node.js & Next.js ---
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Operating System & Editor Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# --- Project-specific scratch / temporary files ---
scratch/
.system_generated/

# AI Data Anomaly Detection & Investigation Copilot
# Environment Variables Template

# LLM API Configuration for AI Copilot Investigation
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Backend service port (default: 8000)
BACKEND_PORT=8000

# Frontend service port (default: 3000)
FRONTEND_PORT=3000

# Public API URL used by frontend browser client
NEXT_PUBLIC_API_URL=http://localhost:8000
